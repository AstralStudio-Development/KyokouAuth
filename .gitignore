# Local deployments and obsolete test runtimes are never versioned: they can contain keys,
# identities and worlds. Ignored does not mean safe to delete; preserve active instances and backups.
run-live/
run-geyser/
run-lobby/
run-proxy/
run-proxy-test/

build/
.gradle/
.kotlin/
*.iml
.idea/

# Compiled probe classes. The .java sources are kept; the .class files are build output.
tools/*.class

# A checkout of LimboAPI, kept only to read how it solves the same protocol problems. It is AGPL and
# nothing from it is copied into this project, so it must never be committed.
tools/limboapi-ref/

# JVM crash dumps and replay logs, if a run dies badly.
hs_err_pid*.log
replay_pid*.log
*.log

# Local assistant state, test caches/evidence, private deployments and backups; never publish.
.narrafork/

# Python helper bytecode is generated test output, not source.
__pycache__/
